# Settings for compose.yaml. Copy this file to .env beside compose.yaml and change the first two lines.
# Lines starting with # are notes. Compose reads .env by itself; nothing else needs to be told about it.

# The image to run. Leave this commented out for the published image, ghcr.io/wandering-wampa/unison-reader:latest.
# For an image you built yourself (docker build -t unisonserver:local . in a clone of the repository), use:
# UNISON_IMAGE=unisonserver:local

# On Windows write folder paths with forward slashes, for example C:/Books/audiobooks.

# Your audiobooks, as a folder on the Docker host: Author/Title/ folders with the audio inside.
UNISON_AUDIOBOOKS=/path/to/audiobooks

# Your ebooks, as a folder on the Docker host: a Calibre library (the one with metadata.db at the top) or any folder of EPUBs.
UNISON_EBOOKS=/path/to/calibre-library

# Where the server keeps its own files (the database, alignments, covers, backups).
# ./data is a folder beside compose.yaml, made on the first start. Back it up; never point it at either library.
UNISON_DATA=./data

# The port on the host. The web client is then at http://<this machine>:8095
UNISON_PORT=8095

# The time zone statistics are counted in when a client does not send its own, as an IANA name
# such as Europe/Berlin or America/Chicago. UTC when left empty.
TZ=

# Optional: a Discord channel webhook that new requests on the wanted list are posted to.
# The address is a secret. Nothing is posted when this is empty.
UNISON_WANTED_WEBHOOK=
