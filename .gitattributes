# Normalise line endings in the repository; keep platform-specific scripts and binaries as they are.
* text=auto
*.ps1 text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
gradlew text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.ttf binary
*.jar binary
*.epub binary
*.zip binary
Dockerfile text eol=lf
.dockerignore text eol=lf
